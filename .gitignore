# ============================================================
# Temporal News Reasoning - .gitignore
# ============================================================

# ----- Python -----
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
*.egg
dist/
build/
.eggs/

# ----- Virtual Environments -----
.venv/
venv/
env/
ENV/

# ----- IDE -----
.vscode/
.idea/
*.swp
*.swo
*~

# ----- Jupyter -----
.ipynb_checkpoints/
*.ipynb_metadata

# ----- OS -----
.DS_Store
Thumbs.db

# ----- Environment Variables -----
.env
*.env.local

# ----- Large Data Files (tracked via Git LFS or downloaded) -----
data/corpus/
data/embeddings/
data/index/
data/training/*.jsonl
!data/training/.gitkeep

# ----- Model Checkpoints -----
checkpoints/
*.safetensors
*.bin
*.ot
*.h5
*.onnx

# ----- Results (large outputs) -----
results/**/*.json
results/**/*.csv
!results/**/.gitkeep

# ----- Logs -----
logs/
*.log
wandb/

# ----- Docker -----
*.tar
*.tar.gz

# ----- Misc -----
*.pkl
*.pickle
*.npy
*.npz
*.faiss
